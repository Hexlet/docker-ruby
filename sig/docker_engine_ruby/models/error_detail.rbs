module DockerEngineRuby
  module Models
    type error_detail = { code: Integer, message: String }

    class ErrorDetail < DockerEngineRuby::Internal::Type::BaseModel
      attr_reader code: Integer?

      def code=: (Integer) -> Integer

      attr_reader message: String?

      def message=: (String) -> String

      def initialize: (?code: Integer, ?message: String) -> void

      def to_hash: -> { code: Integer, message: String }
    end
  end
end
