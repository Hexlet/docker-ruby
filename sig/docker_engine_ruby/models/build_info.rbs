module DockerEngineRuby
  module Models
    type build_info =
      {
        id: String,
        stream: String,
        error: String,
        error_detail: DockerEngineRuby::ErrorDetail,
        status: String,
        progress: String,
        progress_detail: DockerEngineRuby::ProgressDetail,
        aux: DockerEngineRuby::Models::BuildInfo::aux
      }

    class BuildInfo < DockerEngineRuby::Internal::Type::BaseModel
      attr_reader id: String?

      def id=: (String) -> String

      attr_reader stream: String?

      def stream=: (String) -> String

      attr_reader error: String?

      def error=: (String) -> String

      attr_reader error_detail: DockerEngineRuby::ErrorDetail?

      def error_detail=: (
        DockerEngineRuby::ErrorDetail
      ) -> DockerEngineRuby::ErrorDetail

      attr_reader status: String?

      def status=: (String) -> String

      attr_reader progress: String?

      def progress=: (String) -> String

      attr_reader progress_detail: DockerEngineRuby::ProgressDetail?

      def progress_detail=: (
        DockerEngineRuby::ProgressDetail
      ) -> DockerEngineRuby::ProgressDetail

      attr_reader aux: DockerEngineRuby::Models::BuildInfo::aux?

      def aux=: (
        DockerEngineRuby::Models::BuildInfo::aux
      ) -> DockerEngineRuby::Models::BuildInfo::aux

      def initialize: (
        ?id: String,
        ?stream: String,
        ?error: String,
        ?error_detail: DockerEngineRuby::ErrorDetail,
        ?status: String,
        ?progress: String,
        ?progress_detail: DockerEngineRuby::ProgressDetail,
        ?aux: DockerEngineRuby::Models::BuildInfo::aux
      ) -> void

      def to_hash: -> {
        id: String,
        stream: String,
        error: String,
        error_detail: DockerEngineRuby::ErrorDetail,
        status: String,
        progress: String,
        progress_detail: DockerEngineRuby::ProgressDetail,
        aux: DockerEngineRuby::Models::BuildInfo::aux
      }

      type aux = DockerEngineRuby::ImageID | String

      module Aux
        extend DockerEngineRuby::Internal::Type::Union

        def self?.variants: -> ::Array[DockerEngineRuby::Models::BuildInfo::aux]
      end
    end
  end
end
